{
  "name": "ao",
  "version": "0.1.0",
  "description": "AO desktop coding-agent application powered by the embedded Pi SDK",
  "private": true,
  "license": "UNLICENSED",
  "author": {
    "name": "Alejandro AO"
  },
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:visual": "npm run build && VISUAL=1 playwright test e2e/visual.spec.ts",
    "test:visual:update": "npm run build && VISUAL=1 playwright test e2e/visual.spec.ts --update-snapshots",
    "test:smoke:real": "npm run build && AO_REAL_RUNTIME=1 playwright test e2e/smoke.real.spec.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "highlight.js": "11.12.0",
    "marked": "18.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typebox": "1.3.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
